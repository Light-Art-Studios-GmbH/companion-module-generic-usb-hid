		"deploy": "rsync -a --delete --exclude .git --exclude .DS_Store --exclude pkg --exclude .yarn --exclude '*.tgz' ./ \"/Users/lucashoyer/Documents/Companion Developer Modules/companion-module-generic-usb-hid/\""
